{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "name": "Debug Express API",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["run", "dev"],
      "preLaunchTask": "Stop Backend API Port",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "chrome",
      "name": "Debug React User Frontend",
      "request": "launch",
      "url": "http://localhost:5177/home",
      "webRoot": "${workspaceFolder}/frontend/src",
      "preLaunchTask": "Start React User Frontend",
      "userDataDir": true,
      "runtimeArgs": [],
      "timeout": 30000
    },
    {
      "type": "chrome",
      "name": "Debug React Admin Frontend",
      "request": "launch",
      "url": "http://localhost:5178",
      "webRoot": "${workspaceFolder}/frontend/src",
      "preLaunchTask": "Start React Admin Frontend",
      "userDataDir": true,
      "runtimeArgs": [],
      "timeout": 30000
    }
  ],
  "compounds": [
    {
      "name": "Start Full App (F5)",
      "configurations": ["Debug Express API", "Debug React User Frontend"],
      "stopAll": true
    },
    {
      "name": "Start Full App + Admin (F6)",
      "configurations": ["Debug Express API", "Debug React User Frontend", "Debug React Admin Frontend"],
      "stopAll": true
    }
  ]
}
